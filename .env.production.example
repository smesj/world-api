# World API - Production Environment Variables Template
# Copy to .env.production on VM and fill in actual values

# Server Configuration
PORT=3003

# Database
DATABASE_URL="postgresql://world:STRONG_PASSWORD_HERE@localhost:5434/world_api"

# Application
NODE_ENV=production

# Frontend URLs
ADMIN_FRONTEND_URL=https://admin.yourdomain.com

# Clerk
CLERK_SECRET_KEY=your_production_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_production_webhook_secret_here

# Cloudflare R2 (Toshi Ranbo game board photos)
# R2 dashboard -> Manage API Tokens -> create an "Object Read & Write" token scoped to the bucket
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=toshi-ranbo-photos
# Public base URL the bucket is served from (r2.dev subdomain or a custom domain bound to the bucket)
R2_PUBLIC_URL=https://photos.toshi.smesj.world
